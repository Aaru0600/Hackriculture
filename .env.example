# ---- HACKRICULTURE frontend ----

# Base URL of the Node.js + Express backend (React talks ONLY to this for
# auth, farms, predictions and history).
VITE_API_BASE_URL=http://localhost:4000/api

# When "true", app data (auth, predictions, dashboard) comes from src/mock/*
# instead of the API. Keep on until the backend is running.
VITE_USE_MOCKS=true

# Simulated network latency (ms) for the mock layer, so loading states show.
VITE_MOCK_LATENCY=600

# ---- Live data APIs (weather + soil auto-fill) ----
# When "true", the weather/soil services call the public providers below
# DIRECTLY from the browser (no API key required by these providers).
# When "false", they call the Node backend (/weather, /soil) which proxies
# the providers and holds any keys. If a direct call fails, the app falls
# back to bundled mock data so forms still work offline.
VITE_DIRECT_DATA_APIS=true

# Open-Meteo - free, keyless, CORS-enabled weather + geocoding.
VITE_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
VITE_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# ISRIC SoilGrids v2 - free, keyless global soil property map.
VITE_SOILGRIDS_URL=https://rest.isric.org/soilgrids/v2.0/properties/query

# BigDataCloud - free, keyless reverse geocoding (coords -> place name).
VITE_REVERSE_GEOCODE_URL=https://api.bigdatacloud.net/data/reverse-geocode-client
