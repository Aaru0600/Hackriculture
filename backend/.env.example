# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4000

# Frontend origin allowed by CORS (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/hackriculture

# Auth
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Python FastAPI ML service
ML_SERVICE_URL=http://127.0.0.1:8001
ML_TIMEOUT_MS=8000

# Keyless public data providers proxied by /api/weather, /api/geo, /api/soil.
# Defaults below are the public endpoints; override only to self-host / cache.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
SOILGRIDS_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
REVERSE_GEOCODE_URL=https://api.bigdatacloud.net/data/reverse-geocode-client
DATA_TIMEOUT_MS=9000

# KrishiAI assistant - any OpenAI-compatible chat API (Groq, OpenRouter, Together, Gemini-openai, a local model...).
# Leave ASSISTANT_API_KEY blank and the backend answers with a built-in rule-based farming helper.
# Groq free tier: https://console.groq.com/keys
ASSISTANT_API_URL=https://api.groq.com/openai/v1/chat/completions
ASSISTANT_API_KEY=
ASSISTANT_MODEL=llama-3.1-8b-instant
ASSISTANT_TIMEOUT_MS=20000

# Email verification (proves a farmer really owns the address they registered
# with). Leave SMTP_HOST blank in dev - the link is logged to the server
# console and returned as `devLink` in the API response instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=HACKRICULTURE <no-reply@hackriculture.local>
APP_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRES_MIN=1440
EMAIL_VERIFY_MX=true

# Seed a demo admin on first boot (matches the frontend's dev hint).
# MUST be false in production - it creates a known-credentials account.
SEED_DEMO_ADMIN=true
DEMO_ADMIN_EMAIL=admin@hackriculture.test
DEMO_ADMIN_PASSWORD=admin1234

# Swagger UI at /api/docs. Defaults to true in dev, false when NODE_ENV=production.
DOCS_ENABLED=true
