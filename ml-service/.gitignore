.venv/
__pycache__/
*.pyc
.pytest_cache/

# Trained model binaries - rebuilt from data/raw/ by the pipeline / Docker entrypoint.
models/*.joblib

# Cleaned/derived datasets - regenerated by src/prepare_*.py.
data/*.csv
data/*.json

# Raw source datasets ARE committed so a clean clone / Docker build can train.
!data/raw/
!data/raw/*.csv

!data/.gitkeep
!models/.gitkeep

.env
